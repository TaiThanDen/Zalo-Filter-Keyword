/data/zca-login-qr.png

# Local diagnostics and generated audit artifacts
/.codex/
/.tmp_*
/output/
/tmp/

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
